{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    { "source": "/api/backend/:path*", "destination": { "service": "backend", "path": "/:path*" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}